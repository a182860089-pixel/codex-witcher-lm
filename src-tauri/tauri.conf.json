{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Provider Switcher",
  "version": "0.3.2",
  "identifier": "dev.codex-provider-switcher.desktop",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Codex Provider Switcher",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Switch Codex providers and models safely",
    "longDescription": "Unofficial companion for Responses-compatible Codex providers.",
    "copyright": "Copyright 2026 Codex Provider Switcher contributors"
  }
}
